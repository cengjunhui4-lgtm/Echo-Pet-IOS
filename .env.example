# Root-level local configuration guide. Copy values into service-specific local files.
# Never commit real values or rename this file to .env in Git.

# Backend stub: copy to backend/EchoPetBackend/.env
ECHOPET_ENV=local
ECHOPET_AI_PROVIDER=deepseek
ECHOPET_AI_MODEL=deepseek-v4-flash
ECHOPET_AI_MODE=stub
DEEPSEEK_API_KEY=

# Supabase/Edge Functions: copy to supabase/.env for local CLI work only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DEEPSEEK_API_KEY=
